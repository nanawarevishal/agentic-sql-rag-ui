# Google Sign-In - OAuth 2.0 Client ID from
# https://console.cloud.google.com/apis/credentials (same client ID the
# backend's GOOGLE_CLIENT_ID verifies tokens against). Public value, safe to
# ship in the frontend bundle.
VITE_GOOGLE_CLIENT_ID=

# Leave blank in dev - Vite's proxy (vite.config.ts) forwards API paths to
# the local backend. Set to the deployed API origin for a non-proxied build.
VITE_API_BASE_URL=
